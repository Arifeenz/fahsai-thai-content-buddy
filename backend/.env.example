GOOGLE_CLIENT_ID=
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:8080
# Comma-separated emails that get the "admin" role on login
ADMIN_EMAILS=

# Optional: if unset, /generate falls back to randomly picking an admin-authored
# template instead of calling a real LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Monthly spend cap (USD, estimated from token usage) — once hit, /generate
# falls back to templates instead of calling OpenAI for the rest of the month.
OPENAI_MONTHLY_BUDGET_USD=5

# Optional: if unset, verification/reset links are printed to the backend
# console instead of being emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Postgres connection string (Supabase transaction pooler, port 6543 recommended)
DATABASE_URL=

# Optional: if unset, backend error monitoring is disabled.
SENTRY_DSN=

# Supabase Storage (same project as DATABASE_URL) — used to host example-post
# images. Settings → API for the URL and service_role key. If unset, image
# uploads on /example-posts fail with a clear error but caption-only still works.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
